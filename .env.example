# Copy to .env (next to backend/) and fill in. Never commit .env.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
JWT_SECRET=change-me-long-random-string
GEMINI_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Server
ISF_RECORDER_HOST=0.0.0.0
ISF_RECORDER_PORT=8019
PUBLIC_BASE_URL=
AUDIO_STORAGE_ROOT=
AUDIO_RETENTION_DAYS=7
SUPER_ADMIN_PHONES=

# Optional STT providers
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
USE_WHISPER_STT=false
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=multi

# Optional tuning
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_INTELLIGENCE_MODEL=gemini-2.5-flash
DAILY_SUMMARY_HOUR=21
DAILY_SUMMARY_MINUTE=0
BACKUP_DIR=
PG_DUMP_PATH=
PG_RESTORE_PATH=
